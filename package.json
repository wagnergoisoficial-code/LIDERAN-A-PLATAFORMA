{
  "name": "lidera",
  "version": "2.0.0",
  "description": "Fourux: rede social da juventude da igreja. Um só projeto Next.js com a API Express (api/) e as páginas React (web/).",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development nodemon --watch api/src --watch server.mjs server.mjs",
    "build": "node api/scripts/prisma-postgres.js && prisma generate --schema api/prisma/postgres/schema.prisma && next build",
    "start": "prisma migrate deploy --schema api/prisma/postgres/schema.prisma && NODE_ENV=production node server.mjs",
    "test": "jest --config api/jest.config.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema api/prisma/schema.prisma",
    "prisma:postgres": "node api/scripts/prisma-postgres.js",
    "prisma:seed": "node api/prisma/seed.js",
    "seed:demo": "node api/prisma/seed-demo.js",
    "prisma:studio": "prisma studio --schema api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "0.546.0",
    "multer": "^2.5.0",
    "next": "^16.4.6",
    "prisma": "^5.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.14.2",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uikit": "3.25.16"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "22.x"
  }
}
